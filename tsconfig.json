{
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",            // 关键：生成 ESM 模块
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,       // 有时导入 CommonJS 兼容
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "sourceMap": true,
    "allowImportingTsExtensions": true,
  },
  "include": ["src"]
}
