{
  "openapi": "3.1.0",
  "info": {
    "title": "Minecraft Territory API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api",
      "description": "API v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "RegisterBody": {
        "type": "object",
        "properties": {
          "qq": {
            "type": "string",
            "minLength": 3,
            "maxLength": 20
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "maxLength": 100
          },
          "nick_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          }
        },
        "required": [
          "qq",
          "password"
        ]
      },
      "UserProfileResponse": {
        "type": "object",
        "properties": {
          "qq": {
            "type": "string"
          },
          "nick_name": {
            "type": "string",
            "nullable": true
          },
          "personal_credits": {
            "type": "number"
          },
          "status": {
            "type": "string"
          },
          "is_admin": {
            "type": "number"
          },
          "next_nickname_update_at": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "qq",
          "nick_name",
          "personal_credits",
          "status",
          "is_admin",
          "next_nickname_update_at"
        ]
      },
      "UpdateNicknameBody": {
        "type": "object",
        "properties": {
          "nick_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          }
        },
        "required": [
          "nick_name"
        ]
      },
      "AdminTaskType": {
        "type": "string",
        "enum": [
          "REVIEW_TERRITORY_CREATE",
          "REVIEW_TERRITORY_DELETE",
          "REVIEW_TERRITORY_UPDATE",
          "CLEANUP_USER",
          "RECYCLE_TERRITORY_SIZE"
        ]
      },
      "AdminTaskStatus": {
        "type": "string",
        "enum": [
          "PENDING",
          "DONE",
          "IGNORED",
          "REJECTED"
        ]
      },
      "AdminTaskResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/AdminTaskType"
          },
          "status": {
            "$ref": "#/components/schemas/AdminTaskStatus"
          },
          "payload": {
            "nullable": true
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "string"
              }
            ]
          },
          "processed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "string"
              },
              {
                "nullable": true
              }
            ]
          },
          "processed_by": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "type",
          "status",
          "created_at",
          "processed_at",
          "processed_by"
        ]
      },
      "ListTasksResponse": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/AdminTaskResponse"
        }
      },
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          }
        },
        "required": [
          "success"
        ]
      },
      "ProcessTaskBody": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "example": "10"
          },
          "approved": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "taskId",
          "approved"
        ]
      },
      "TerritoryResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "owner_id": {
            "type": "string"
          },
          "credits": {
            "type": "number"
          },
          "x1": {
            "type": "number"
          },
          "z1": {
            "type": "number"
          },
          "x2": {
            "type": "number"
          },
          "z2": {
            "type": "number"
          },
          "area": {
            "type": "number"
          },
          "cost": {
            "type": "number"
          },
          "type": {
            "type": "string",
            "enum": [
              "NO_ENTRY",
              "NO_BREAK"
            ],
            "example": "NO_ENTRY"
          },
          "status": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "owner_id",
          "credits",
          "x1",
          "z1",
          "x2",
          "z2",
          "area",
          "cost",
          "type",
          "status"
        ]
      },
      "CreateTerritoryRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "type": {
            "type": "string",
            "enum": [
              "NO_ENTRY",
              "NO_BREAK"
            ],
            "example": "NO_ENTRY"
          }
        },
        "required": [
          "name"
        ]
      },
      "TerritoryListResponse": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/TerritoryResponse"
        }
      },
      "SuccessMessageResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "UpdateLocationRequest": {
        "type": "object",
        "properties": {
          "x1": {
            "type": "integer"
          },
          "z1": {
            "type": "integer"
          },
          "x2": {
            "type": "integer"
          },
          "z2": {
            "type": "integer"
          }
        },
        "required": [
          "x1",
          "z1",
          "x2",
          "z2"
        ]
      },
      "InvitationResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "territory_id": {
            "type": "string"
          },
          "territory_name": {
            "type": "string"
          },
          "inviter_qq": {
            "type": "string"
          },
          "invitee_qq": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "territory_id",
          "territory_name",
          "inviter_qq",
          "invitee_qq",
          "created_at"
        ]
      },
      "InvitationListResponse": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/InvitationResponse"
        }
      },
      "InviteMemberRequest": {
        "type": "object",
        "properties": {
          "qq": {
            "type": "string",
            "minLength": 5,
            "maxLength": 20
          }
        },
        "required": [
          "qq"
        ]
      },
      "DonateRequest": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true
          }
        },
        "required": [
          "amount"
        ]
      },
      "RemoveMemberRequest": {
        "type": "object",
        "properties": {
          "qq": {
            "type": "string",
            "minLength": 5,
            "maxLength": 20
          }
        },
        "required": [
          "qq"
        ]
      },
      "NotificationResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "is_read": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "content",
          "is_read",
          "created_at"
        ]
      },
      "NotificationListResponse": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/NotificationResponse"
        }
      }
    },
    "parameters": {}
  },
  "paths": {
    "/auth/register": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Register a new user",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "success",
                    "code"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Login user",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "qq": {
                    "type": "string",
                    "minLength": 3
                  },
                  "password": {
                    "type": "string",
                    "minLength": 6
                  }
                },
                "required": [
                  "qq",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "qq": {
                      "type": "string"
                    },
                    "msg": {
                      "type": "string"
                    },
                    "access_token": {
                      "type": "string"
                    },
                    "token_type": {
                      "type": "string"
                    },
                    "expires_in": {
                      "type": "number"
                    },
                    "refresh_token": {
                      "type": "string"
                    },
                    "scope": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "qq",
                    "msg",
                    "access_token",
                    "token_type",
                    "expires_in",
                    "refresh_token"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/auth/authorize": {
      "get": {
        "tags": [
          "OAuth2"
        ],
        "summary": "OAuth2 Authorize Endpoint",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "client_id",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "uri"
            },
            "required": true,
            "name": "redirect_uri",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "code"
              ]
            },
            "required": true,
            "name": "response_type",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "state",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Authorization Code",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "redirect_uri": {
                      "type": "string"
                    },
                    "state": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "redirect_uri"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/auth/token": {
      "post": {
        "tags": [
          "OAuth2"
        ],
        "summary": "OAuth2 Token Endpoint",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "grant_type": {
                    "type": "string",
                    "enum": [
                      "authorization_code"
                    ]
                  },
                  "code": {
                    "type": "string"
                  },
                  "redirect_uri": {
                    "type": "string",
                    "format": "uri"
                  },
                  "client_id": {
                    "type": "string"
                  },
                  "client_secret": {
                    "type": "string"
                  }
                },
                "required": [
                  "grant_type",
                  "code",
                  "redirect_uri",
                  "client_id"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Access Token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": {
                      "type": "string"
                    },
                    "token_type": {
                      "type": "string"
                    },
                    "expires_in": {
                      "type": "number"
                    },
                    "refresh_token": {
                      "type": "string"
                    },
                    "scope": {
                      "type": "string",
                      "nullable": true
                    }
                  },
                  "required": [
                    "access_token",
                    "token_type",
                    "expires_in",
                    "refresh_token"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Refresh Access Token",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "refresh_token": {
                    "type": "string"
                  }
                },
                "required": [
                  "refresh_token"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New Access Token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": {
                      "type": "string"
                    },
                    "token_type": {
                      "type": "string"
                    },
                    "expires_in": {
                      "type": "number"
                    },
                    "refresh_token": {
                      "type": "string"
                    },
                    "scope": {
                      "type": "string",
                      "nullable": true
                    }
                  },
                  "required": [
                    "access_token",
                    "token_type",
                    "expires_in",
                    "refresh_token"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "Authentication",
          "User"
        ],
        "summary": "Get current user profile",
        "responses": {
          "200": {
            "description": "User profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfileResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/me/nickname": {
      "patch": {
        "tags": [
          "Authentication",
          "User"
        ],
        "summary": "Update user nickname",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateNicknameBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Nickname updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "message"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/admin/tasks": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "List admin tasks",
        "parameters": [
          {
            "schema": {
              "$ref": "#/components/schemas/AdminTaskStatus"
            },
            "required": false,
            "name": "status",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "List of tasks",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListTasksResponse"
                }
              }
            }
          }
        }
      }
    },
    "/admin/process": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Process an admin task",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProcessTaskBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task processed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/territories": {
      "post": {
        "tags": [
          "Territory"
        ],
        "summary": "Create a new territory",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTerritoryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Directory created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TerritoryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/territories/mine": {
      "get": {
        "tags": [
          "Territory"
        ],
        "summary": "List my territories",
        "responses": {
          "200": {
            "description": "List of territories",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TerritoryListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/territories/{id}": {
      "delete": {
        "tags": [
          "Territory"
        ],
        "summary": "Request delete territory",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Deletion requested",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessMessageResponse"
                }
              }
            }
          }
        }
      }
    },
    "/territories/{id}/location": {
      "put": {
        "tags": [
          "Territory"
        ],
        "summary": "Update territory location (Claim/Resize/Move)",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateLocationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Location updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessMessageResponse"
                }
              }
            }
          }
        }
      }
    },
    "/territories/invitations/mine": {
      "get": {
        "tags": [
          "Territory"
        ],
        "summary": "List my received invitations",
        "responses": {
          "200": {
            "description": "List of invitations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/territories/{id}/invitations": {
      "get": {
        "tags": [
          "Territory"
        ],
        "summary": "List invitations for a territory",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "List of invitations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/territories/{id}/invite": {
      "post": {
        "tags": [
          "Territory"
        ],
        "summary": "Invite a member to territory",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteMemberRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Invitation sent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessMessageResponse"
                }
              }
            }
          }
        }
      }
    },
    "/territories/invitations/{id}/accept": {
      "post": {
        "tags": [
          "Territory"
        ],
        "summary": "Accept an invitation",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "Invitation ID"
            },
            "required": true,
            "description": "Invitation ID",
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Invitation accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessMessageResponse"
                }
              }
            }
          }
        }
      }
    },
    "/territories/invitations/{id}": {
      "delete": {
        "tags": [
          "Territory"
        ],
        "summary": "Revoke or reject an invitation",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "Invitation ID"
            },
            "required": true,
            "description": "Invitation ID",
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Invitation revoked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessMessageResponse"
                }
              }
            }
          }
        }
      }
    },
    "/territories/{id}/donate": {
      "post": {
        "tags": [
          "Territory"
        ],
        "summary": "Donate personal credits to territory",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DonateRequest"
              }
