{
  "openapi": "3.1.0",
  "info": {
    "title": "Minecraft Territory API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api",
      "description": "API v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "UserProfileResponse": {
        "type": "object",
        "properties": {
          "qq": {
            "type": "string"
          },
          "nick_name": {
            "type": "string",
            "nullable": true
          },
          "personal_credits": {
            "type": "number"
          },
          "status": {
            "type": "string"
          },
          "is_admin": {
            "type": "number"
          }
        },
        "required": [
          "qq",
          "nick_name",
          "personal_credits",
          "status",
          "is_admin"
        ]
      },
      "AdminTaskType": {
        "type": "string",
        "enum": [
          "REVIEW_TERRITORY_CREATE",
          "REVIEW_TERRITORY_DELETE",
          "REVIEW_TERRITORY_UPDATE",
          "CLEANUP_USER",
          "RECYCLE_TERRITORY_SIZE"
        ]
      },
      "AdminTaskStatus": {
        "type": "string",
        "enum": [
          "PENDING",
          "DONE",
          "IGNORED",
          "REJECTED"
        ]
      },
      "AdminTaskResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/AdminTaskType"
          },
          "status": {
            "$ref": "#/components/schemas/AdminTaskStatus"
          },
          "payload": {
            "nullable": true
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "string"
              }
            ]
          },
          "processed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "string"
              },
              {
                "nullable": true
              }
            ]
          },
          "processed_by": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "type",
          "status",
          "created_at",
          "processed_at",
          "processed_by"
        ]
      },
      "ListTasksResponse": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/AdminTaskResponse"
        }
      },
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          }
        },
        "required": [
          "success"
        ]
      },
      "ProcessTaskBody": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "example": "10"
          },
          "approved": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "taskId",
          "approved"
        ]
      },
      "TerritoryType": {
        "type": "string",
        "enum": [
          "NO_ENTRY",
          "NO_BREAK"
        ]
      },
      "ProposeCreateResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "team_id": {
            "type": "string"
          },
          "area": {
            "type": "string"
          },
          "cost": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "x1": {
            "type": "number"
          },
          "z1": {
            "type": "number"
          },
          "x2": {
            "type": "number"
          },
          "z2": {
            "type": "number"
          },
          "type": {
            "$ref": "#/components/schemas/TerritoryType"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "team_id",
          "area",
          "cost",
          "name",
          "x1",
          "z1",
          "x2",
          "z2",
          "type",
          "status"
        ]
      },
      "ProposeCreateBody": {
        "type": "object",
        "properties": {
          "teamId": {
            "type": "string",
            "example": "100"
          },
          "x1": {
            "type": "integer"
          },
          "z1": {
            "type": "integer"
          },
          "x2": {
            "type": "integer"
          },
          "z2": {
            "type": "integer"
          },
          "type": {
            "$ref": "#/components/schemas/TerritoryType"
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "teamId",
          "x1",
          "z1",
          "x2",
          "z2",
          "type",
          "name"
        ]
      },
      "ProposeDeleteBody": {
        "type": "object",
        "properties": {
          "territoryId": {
            "type": "string",
            "example": "200"
          }
        },
        "required": [
          "territoryId"
        ]
      },
      "TerritoryListResponse": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "team_id": {
              "type": "string"
            },
            "x1": {
              "type": "number"
            },
            "z1": {
              "type": "number"
            },
            "x2": {
              "type": "number"
            },
            "z2": {
              "type": "number"
            },
            "area": {
              "type": "number"
            },
            "type": {
              "$ref": "#/components/schemas/TerritoryType"
            },
            "status": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name",
            "team_id",
            "x1",
            "z1",
            "x2",
            "z2",
            "area",
            "type",
            "status"
          ]
        }
      },
      "CreateTeamResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "100"
          },
          "name": {
            "type": "string"
          },
          "owner_id": {
            "type": "string"
          },
          "team_credits": {
            "type": "string",
            "example": "0"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "string"
              },
              {
                "nullable": true
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "owner_id",
          "team_credits",
          "created_at"
        ]
      },
      "CreateTeamBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "example": "My Team"
          }
        },
        "required": [
          "name"
        ]
      },
      "JoinTeamBody": {
        "type": "object",
        "properties": {
          "teamId": {
            "type": "string",
            "example": "100",
            "description": "Team ID to join"
          }
        },
        "required": [
          "teamId"
        ]
      },
      "TransferBody": {
        "type": "object",
        "properties": {
          "teamId": {
            "type": "string",
            "example": "100"
          },
          "newOwnerId": {
            "type": "string",
            "example": "12345678",
            "description": "QQ of the new owner"
          }
        },
        "required": [
          "teamId",
          "newOwnerId"
        ]
      },
      "TeamSummaryResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "owner_id": {
            "type": "string"
          },
          "team_credits": {
            "type": "number"
          },
          "members_count": {
            "type": "number"
          },
          "territories_count": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "name",
          "owner_id",
          "team_credits"
        ]
      },
      "MyTeamsResponse": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/TeamSummaryResponse"
        }
      },
      "TeamDetailResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "owner_id": {
            "type": "string"
          },
          "team_credits": {
            "type": "number"
          },
          "members": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "qq": {
                  "type": "string"
                },
                "joined_at": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date"
                    },
                    {
                      "type": "string"
                    }
                  ]
                }
              },
              "required": [
                "qq",
                "joined_at"
              ]
            }
          },
          "territories": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "area": {
                  "type": "number"
                }
              },
              "required": [
                "id",
                "name",
                "status",
                "area"
              ]
            }
          }
        },
        "required": [
          "id",
          "name",
          "owner_id",
          "team_credits",
          "members",
          "territories"
        ]
      },
      "ContributeBody": {
        "type": "object",
        "properties": {
          "teamId": {
            "type": "string",
            "example": "100"
          },
          "amount": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true,
            "example": 10,
            "description": "Amount of credits to contribute"
          }
        },
        "required": [
          "teamId",
          "amount"
        ]
      },
      "CastVoteBody": {
        "type": "object",
        "properties": {
          "voteId": {
            "type": "string",
            "example": "500"
          },
          "decision": {
            "type": "boolean",
            "description": "true for approve, false for reject"
          }
        },
        "required": [
          "voteId",
          "decision"
        ]
      },
      "VoteListResponse": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "team_id": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "title": {
              "type": "string",
              "nullable": true
            },
            "creator_qq": {
              "type": "string"
            },
            "deadline": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "string"
                }
              ]
            },
            "yes_votes": {
              "type": "number"
            },
            "no_votes": {
              "type": "number"
            }
          },
          "required": [
            "id",
            "team_id",
            "type",
            "status",
            "title",
            "creator_qq",
            "deadline"
          ]
        }
      }
    },
    "parameters": {}
  },
  "paths": {
    "/auth/register": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Register a new user",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "qq": {
                    "type": "string",
                    "minLength": 3
                  },
                  "password": {
                    "type": "string",
                    "minLength": 6
                  }
                },
                "required": [
                  "qq",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "success",
                    "code"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Login user",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "qq": {
                    "type": "string",
                    "minLength": 3
                  },
                  "password": {
                    "type": "string",
                    "minLength": 6
                  }
                },
                "required": [
                  "qq",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "qq": {
                      "type": "string"
                    },
                    "msg": {
                      "type": "string"
                    },
                    "access_token": {
                      "type": "string"
                    },
                    "token_type": {
                      "type": "string"
                    },
                    "expires_in": {
                      "type": "number"
                    },
                    "refresh_token": {
                      "type": "string"
                    },
                    "scope": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "qq",
                    "msg",
                    "access_token",
                    "token_type",
                    "expires_in",
                    "refresh_token"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/auth/authorize": {
      "get": {
        "tags": [
          "OAuth2"
        ],
        "summary": "OAuth2 Authorize Endpoint",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "client_id",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "uri"
            },
            "required": true,
            "name": "redirect_uri",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "code"
              ]
            },
            "required": true,
            "name": "response_type",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "state",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Authorization Code",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "redirect_uri": {
                      "type": "string"
                    },
                    "state": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code",
                    "redirect_uri"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/auth/token": {
      "post": {
        "tags": [
          "OAuth2"
        ],
        "summary": "OAuth2 Token Endpoint",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "grant_type": {
                    "type": "string",
                    "enum": [
                      "authorization_code"
                    ]
                  },
                  "code": {
                    "type": "string"
                  },
                  "redirect_uri": {
                    "type": "string",
                    "format": "uri"
                  },
                  "client_id": {
                    "type": "string"
                  },
                  "client_secret": {
                    "type": "string"
                  }
                },
                "required": [
                  "grant_type",
                  "code",
                  "redirect_uri",
                  "client_id"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Access Token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": {
                      "type": "string"
                    },
                    "token_type": {
                      "type": "string"
                    },
                    "expires_in": {
                      "type": "number"
                    },
                    "refresh_token": {
                      "type": "string"
                    },
                    "scope": {
                      "type": "string",
                      "nullable": true
                    }
                  },
                  "required": [
                    "access_token",
                    "token_type",
                    "expires_in",
                    "refresh_token"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Refresh Access Token",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "refresh_token": {
                    "type": "string"
                  }
                },
                "required": [
                  "refresh_token"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New Access Token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": {
                      "type": "string"
                    },
                    "token_type": {
                      "type": "string"
                    },
                    "expires_in": {
                      "type": "number"
                    },
                    "refresh_token": {
                      "type": "string"
                    },
                    "scope": {
                      "type": "string",
                      "nullable": true
                    }
                  },
                  "required": [
                    "access_token",
                    "token_type",
                    "expires_in",
                    "refresh_token"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "Authentication",
          "User"
        ],
        "summary": "Get current user profile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "User profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfileResponse"
                }
              }
            }
          }
        }
      }
    },
    "/admin/tasks": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "List admin tasks",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "$ref": "#/components/schemas/AdminTaskStatus"
            },
            "required": false,
            "name": "status",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "List of tasks",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListTasksResponse"
                }
              }
            }
          }
        }
      }
    },
    "/admin/process": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Process an admin task",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProcessTaskBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task processed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/territories/create": {
      "post": {
        "tags": [
          "Territory"
        ],
        "summary": "Propose creating a new territory",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProposeCreateBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Proposal created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProposeCreateResponse"
                }
              }
            }
          }
        }
      }
    },
    "/territories/delete": {
      "post": {
        "tags": [
          "Territory"
        ],
        "summary": "Propose deleting an existing territory",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProposeDeleteBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Delete proposal created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/territories/": {
      "get": {
        "tags": [
          "Territory"
        ],
        "summary": "List territories",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "teamId",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "List of territories",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TerritoryListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/teams/create": {
      "post": {
        "tags": [
          "Team"
        ],
        "summary": "Create a new team",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTeamBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Team created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateTeamResponse"
                }
              }
            }
          }
        }
      }
    },
    "/teams/join": {
      "post": {
        "tags": [
          "Team"
        ],
        "summary": "Join a team",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
